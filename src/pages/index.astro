---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects';
import iconResume from '@tabler/icons/outline/file-cv.svg?raw';
import iconGithub from '@tabler/icons/outline/brand-github.svg?raw';
import iconLinkedin from '@tabler/icons/outline/brand-linkedin.svg?raw';
import iconLinktree from '@tabler/icons/outline/brand-linktree.svg?raw';

const { all, caseStudies, inProgress } = await getProjects();
const featured = caseStudies.filter((p) => p.featured);

// Hero launch pads: one primary (resume) and the three profiles.
const pads = [
  { label: 'Resume', href: '/resume', icon: iconResume, primary: true },
  { label: 'GitHub', href: 'https://github.com/ZCandont', icon: iconGithub },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/zachary-candau/', icon: iconLinkedin },
  { label: 'Linktree', href: 'https://linktr.ee/zcandont', icon: iconLinktree },
];

// Experience timeline, newest first. Skills are short tags only, not a recap of the work itself.
const experience = [
  { range: '09/2026 to Present', role: 'Founding Analysis Engineer', org: 'Stealth Space Startup', skills: ['COMSOL FEA', 'Design verification', 'R&D', 'Prototyping'], current: true },
  { range: '05/2026 to 09/2026', role: 'Mechanical Engineering Intern', org: 'Zipline International', skills: ['Composites analysis', 'Tooling design', 'Electronics layout'] },
  { range: '01/2024 to 06/2024', role: 'Chief Engineer, Senior Design (UAV Wing)', org: 'UC San Diego', skills: ['Composite layup', 'SolidWorks', 'Abaqus FEA', 'Leadership'] },
  { range: '01/2023 to 06/2024', role: 'Instructional Assistant', org: 'UCSD Structural Engineering Dept.', skills: ['Teaching', 'Mentorship', 'Assessment design'] },
  { range: '01/2023 to 06/2023', role: 'Undergraduate Research Lab Assistant', org: 'Advanced Aerospace Composites Laboratory', skills: ['Data analysis', 'Test setup design', 'Signal processing', 'Ultrasonic NDE'] },
  { range: '10/2020 to 06/2022', role: 'Aerodynamicist', org: 'UCSD Triton Racing, Formula SAE', skills: ['SolidWorks', 'CATIA', 'FEA', 'CFD'] },
];

// Skills highlight: every skill points at the work that proves it (case studies link, roles and shell projects don't yet).
const cs = Object.fromEntries(all.map((c) => [c.id, { label: c.data.title, href: `/projects/${c.id}/` }]));
const skills: { name: string; proof: { label: string; href?: string }[] }[] = [
  { name: 'Finite element analysis', proof: [{ label: 'COMSOL, founding analysis engineer' }, cs['uav-composite-wing'], { label: 'Triton Racing FSAE' }] },
  { name: 'Composite structures', proof: [cs['uav-composite-wing'], cs['composite-wing-structural-analysis'], { label: 'Stepped-lap repair patch' }, { label: 'Composites analysis, Zipline' }] },
  { name: 'CAD', proof: [cs['uav-composite-wing'], cs['composite-bonding-fixture'], { label: 'CATIA, FSAE' }] },
  { name: 'Tooling and fixtures', proof: [cs['composite-bonding-fixture'], { label: 'Tooling design, Zipline' }] },
  { name: 'Test design and NDE', proof: [cs['uav-composite-wing'], { label: 'Ultrasonic C-scan' }, { label: 'Test setup design, composites lab' }] },
  { name: 'Python and machine learning', proof: [cs['microstructure-property-prediction'], cs['solar-flare-cnn']] },
  { name: 'MATLAB', proof: [cs['uav-composite-wing'], cs['composite-wing-structural-analysis']] },
  { name: 'Aerodynamics and CFD', proof: [{ label: 'FSAE rear wing' }, { label: 'Aerodynamicist, Triton Racing' }] },
  { name: 'Leadership and teaching', proof: [cs['uav-composite-wing'], { label: 'Instructional Assistant, UCSD' }] },
];
---
<Base
  title="Zachary Candau | Aerospace Engineer"
  description="Portfolio of Zachary Candau, an aerospace engineer working on composite structures, structural analysis and electric propulsion."
>
  <section class="hero" aria-labelledby="hero-name">
    <div class="wrap hero-grid">
      <h1 id="hero-name" class="hero-name" data-converge><span>Zachary</span> <span>Candau</span></h1>
      <div class="hero-side">
        <div class="orbit-stage">
          <p class="hero-role"><span>Aerospace</span> <span>Engineer</span></p>
          <span class="orbit-path" aria-hidden="true"></span>
          <ul class="fields" aria-label="Fields">
            {['Aerospace', 'Astrospace', 'Automotive'].map((f, k) => (
              <li style={`--k:${k}`}><span class="ox"><span class="oy"><span class="tag">{f}</span></span></span></li>
            ))}
          </ul>
        </div>
        <p class="lead">Designing, analyzing, and testing composite structures and space hardware.</p>
      </div>
      <div class="hero-actions">
        {pads.map((b) => (
          <a class:list={['pad', { 'pad-primary': b.primary }]} href={b.href} rel={b.primary ? undefined : 'me noopener'} data-burst>
            <span class="pad-icon" aria-hidden="true" set:html={b.icon} />
            <span>{b.label}</span>
          </a>
        ))}
      </div>
    </div>
    <ul class="lane" aria-label="Current projects">
      {inProgress.map((p, i) => (
        <li style={`--i:${i};--row:${i % 3};--row2:${i % 2}`}>
          <a href={p.href}>
            <span class="lane-core" aria-hidden="true"></span>
            <span class="lane-title">{p.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="wrap now">
      <span class="now-mark" aria-hidden="true"><span class="now-sat"></span></span>
      <span class="now-label">Orbit</span>
      <span class="now-text">Founding design and analysis engineer at electric propulsion startup</span>
    </div>
  </section>

  <section id="about">
    <div class="wrap about-grid">
      <div>
        <h2 data-particle-target>About</h2>
        <p class="prose">
          I'm an aerospace engineer focused on composite structures, structural analysis and hands-on testing.
          I hold a B.S. in Structural Engineering from UC San Diego, am completing my M.S. there in advanced
          aerospace composites, and work as a founding analysis engineer at a space startup building electric propulsion.
        </p>
        <p class="prose">
          I am a hardware engineer who wants to build and design hardware that’s fun again. At the same time I want to use
          the resources at my disposal and my research experience to build new pieces of software that anyone can access.
          Every hardware engineer should learn to be a software engineer too. Mechanical engineers should be aero, aero
          should be electrical, electrical should be SWE, SWE should be financiers, financiers should be quants, and quants
          should be hardware engineers. Creating content to share my current place as well as my journey of growth in all
          of these aspects.
        </p>
      </div>
      <figure class="plate about-photo">
        <img src="/images/about/profile-palace-of-fine-arts.jpg" alt="Zachary Candau at the Palace of Fine Arts, San Francisco, at night" width="1200" height="1600" loading="lazy" decoding="async">
        <figcaption>Palace of Fine Arts, San Francisco</figcaption>
      </figure>
    </div>
  </section>

  <section id="experience">
    <div class="wrap">
      <h2 data-particle-target>Experience</h2>
      <ol class="timeline">
        {experience.map((e) => (
          <li class:list={{ current: e.current }}>
            <span class="when">{e.range}</span>
            <div class="what">
              <h3>{e.role}</h3>
              <p>{e.org}</p>
              <ul class="skill-tags">
                {e.skills.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <p class="more"><a href="/resume">See the full resume</a></p>
    </div>
  </section>

  <section id="skills">
    <div class="wrap">
      <h2 data-particle-target>Skills</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{s.name}</dt>
            <dd>
              <ul>
                {s.proof.map((p) => <li>{p.href ? <a href={p.href}>{p.label}</a> : p.label}</li>)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <h2 data-particle-target>Projects</h2>

      <h3 class="section-sub">Featured</h3>
      <ul class="current">
        {featured.map((p) => (
          <li>
            <a class="exposure" href={p.href}>
              {p.cover && (
                <span class="plate">
                  <img class:list={{ negative: p.negative }} src={p.cover} alt={p.coverAlt ?? ''} loading="lazy" decoding="async">
                </span>
              )}
              <span class="code">{p.code.map((c) => <span>{c}</span>)}</span>
              <span class="exposure-title">{p.title}</span>
              <span class="exposure-text">{p.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more-work"><a class="pad" href="/portfolio" data-burst><span>Open the full portfolio</span></a></p>
    </div>
  </section>

  <section id="gallery">
    <div class="wrap">
      <h2 data-particle-target>Gallery</h2>
      <ul class="album">
        <li class="plate"><img src="/images/gallery/team-poster-presentation.jpg" alt="Zachary Candau and his senior design team presenting their composite UAV wing project at a poster session" loading="lazy" decoding="async"></li>
        <li class="plate"><img src="/images/gallery/ppe-lab.jpg" alt="Zachary Candau in full PPE, respirator and gloves, in a materials lab" loading="lazy" decoding="async"></li>
      </ul>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap">
      <h2 data-particle-target>Rendezvous</h2>
      <p class="prose">Reach out about engineering roles, projects, research, collaboration, or anything new and interesting!</p>
      <a class="email" href="mailto:zbcandau@gmail.com">zbcandau@gmail.com</a>
      <ul class="contact-links">
        <li><a href="https://www.linkedin.com/in/zachary-candau/" rel="me noopener">LinkedIn</a></li>
        <li><a href="https://github.com/ZCandont" rel="me noopener">GitHub</a></li>
        <li><a href="https://linktr.ee/zcandont" rel="me noopener">Linktree</a></li>
        <li><a href="/resume">Resume</a></li>
      </ul>
    </div>
  </section>
</Base>
