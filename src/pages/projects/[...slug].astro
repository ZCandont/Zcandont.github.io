---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, teamSize, year, tools, links } = project.data;
---
<Base title={`${title} | Zachary Candau`} description={summary}>
  <section class="case-header">
    <div class="wrap">
      <a class="back" href="/#projects">&larr; All projects</a>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <dl class="meta-grid">
        <div><dt>Role</dt><dd>{role}</dd></div>
        <div><dt>Team</dt><dd>{teamSize} {teamSize === 1 ? 'person' : 'people'}</dd></div>
        <div><dt>Year</dt><dd>{year}</dd></div>
        <div><dt>Tools</dt><dd>{tools.join(', ')}</dd></div>
      </dl>
      {links.length > 0 && (
        <div class="actions">
          {links.map((l) => <a class="btn btn-ghost" href={l.url} rel="noopener">{l.label}</a>)}
        </div>
      )}
    </div>
  </section>
  <section class="case-body">
    <div class="wrap prose-body">
      <Content />
    </div>
  </section>
</Base>
