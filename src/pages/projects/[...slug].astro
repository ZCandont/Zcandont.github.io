---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import iconBack from '@tabler/icons/outline/arrow-left.svg?raw';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, status, role, teamSize, year, tools, links } = project.data;
const inProgress = status === 'in-progress';
---
<Base title={`${title} | Zachary Candau`} description={summary ?? `${title}: a current project by Zachary Candau. Report in progress.`}>
  <section class="case-header">
    <div class="wrap">
      <a class="back" href="/portfolio"><Fragment set:html={iconBack} />Back to portfolio</a>
      <h1 data-particle-target>{title}</h1>
      {summary && <p class="lead">{summary}</p>}
      <dl class="meta-grid">
        {inProgress && <div><dt>Status</dt><dd class="status">In progress</dd></div>}
        {role && <div><dt>Role</dt><dd>{role}</dd></div>}
        {teamSize && <div><dt>Team</dt><dd>{teamSize} {teamSize === 1 ? 'person' : 'people'}</dd></div>}
        <div><dt>Year</dt><dd>{year}</dd></div>
        {tools.length > 0 && <div><dt>Tools</dt><dd>{tools.join(', ')}</dd></div>}
      </dl>
      {links.length > 0 && (
        <div class="actions">
          {links.map((l) => <a class="btn btn-ghost" href={l.url} rel="noopener">{l.label}</a>)}
        </div>
      )}
    </div>
  </section>
  <section class="case-body">
    <div class="wrap prose-body">
      {inProgress && !project.body?.trim() && (
        <p>This report is in progress. The full write-up will build here as the project develops.</p>
      )}
      <Content />
    </div>
  </section>
</Base>
